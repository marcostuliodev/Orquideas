# ---- App ----
# MongoDB: string de conexão (ex: MongoDB Atlas ou Vercel MongoDB)
# Formato: mongodb+srv://username:password@cluster0.mongodb.net/orquideas?retryWrites=true&w=majority
# Ou local: mongodb://127.0.0.1:27017/orquideas
DATABASE_URL="mongodb+srv://username:password@cluster0.example.mongodb.net/orquideas?retryWrites=true&w=majority"

# Segredo para assinar os JWT de sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Segredo para proteger a rota de cron (src/app/api/cron/reminders).
# Em dev, se não definido, a rota aceita qualquer chamada (com aviso no log).
CRON_SECRET=""

# ---- Billing (Asaas) ----
# Em dev, deixe ASAAS_SANDBOX=true e preencha as chaves do sandbox.
# Em produção, ASAAS_SANDBOX=false e chaves reais (NUNCA expostas ao client).
ASAAS_SANDBOX="true"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
