// Prisma schema — Orquídeas SaaS
// MongoDB: Usado via MongoDB Atlas ou Vercel MongoDB
// IDs devem ter @map("_id"). Enums/arrays são modelados como String/Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Modelos MongoDB — _id é mapeado automaticamente via @map

model User {
  id          String    @id @map("_id") @default(cuid())
  email       String    @unique
  name        String
  passwordHash String
  plan        String    @default("free") // free | pro | premium
  cpfCnpj     String?   // necessário para criar cliente na Asaas (produção)
  asaasCustomerId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orchids           Orchid[]
  observations      Observation[]
  // subscriptions removido — usar coleção separada ou campo simples se necessário
  recurringReminders RecurringReminder[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
}

model Orchid {
  id          String    @id @map("_id") @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String // nome de identificação da muda/planta
  species     String? // espécie (ex.: Phalaenopsis)
  hybrid      String? // híbrido / cultivar
  origin      String? // compra | troca | seedling | divisão | autopolinização
  acquiredAt  DateTime?
  stage       String   @default("seedling") // seedling | juvenile | adult | blooming
  parentInfo  String? // genealogia (genética dos pais)
  batch       String? // lote (uso comercial)
  location    String? // onde está (estufa A, bancada 2...)
  photos      Json // array de { url, caption? }
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  careLogs           CareLog[]
  reminders          Reminder[]
  cultivationEvents  CultivationEvent[]
  recurringReminders RecurringReminder[]

  @@index([userId])
  @@index([stage])
}

model CareLog {
  id        String   @id @map("_id") @default(cuid())
  orchidId  String
  
  orchid    Orchid   @relation(fields: [orchidId], references: [id], onDelete: Cascade)
  type      String // water | fertilize | treat | observe | repot
  date      DateTime @default(now())
  note      String?

  @@index([orchidId])
}

model Reminder {
  id        String   @id @map("_id") @default(cuid())
  orchidId  String
  orchid    Orchid   @relation(fields: [orchidId], references: [id], onDelete: Cascade)
  type      String // water | fertilize | treat | repot | custom
  dueDate   DateTime
  done      Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  // Vinculação opcional a um lembrete recorrente (gerado pelo scheduler).
  recurringReminderId String?
  recurringReminder   RecurringReminder? @relation(fields: [recurringReminderId], references: [id], onDelete: SetNull)

  @@index([orchidId])
  @@index([dueDate])
  @@index([recurringReminderId])
}

model CultivationEvent {
  id         String   @id @map("_id") @default(cuid())
  orchidId   String
  orchid     Orchid   @relation(fields: [orchidId], references: [id], onDelete: Cascade)
  type       String // water | fertilize | bloom | treat | repot | measure | photo | note
  occurredAt DateTime @default(now())
  title      String?
  note       String?
  payload    Json? // metadados livres (ex.: medições, condições)
  photos     Json    @default("[]") // array de { url, caption? }
  createdAt  DateTime @default(now())

  @@index([orchidId])
  @@index([type])
  @@index([occurredAt])
}

model RecurringReminder {
  id         String    @id @map("_id") @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orchidId   String? // se nulo, é um lembrete geral do usuário
  orchid     Orchid?   @relation(fields: [orchidId], references: [id], onDelete: Cascade)
  type       String // water | fertilize | treat | repot | custom
  freq       String // daily | weekly | monthly | custom
  intervalN  Int       @default(1)
  anchorDate DateTime  @default(now())
  nextDueAt  DateTime  @default(now())
  endAfter   DateTime?
  active     Boolean   @default(true)
  note       String?
  lastGenAt  DateTime?
  createdAt  DateTime  @default(now())

  reminders  Reminder[]

  @@index([userId, nextDueAt])
}

model Notification {
  id        String   @id @map("_id") @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @map("_id") @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String

  @@index([userId])
}

model Observation {
  id        String   @id @map("_id") @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region    String // norte | nordeste | centro-oeste | sudeste | sul
  city      String?
  date      DateTime @default(now())
  tempMin   Float?
  tempMax   Float?
  humidity  Float? // %
  rainfall  Float? // mm
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
}